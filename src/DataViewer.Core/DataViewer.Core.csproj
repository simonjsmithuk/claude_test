<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>DataViewer.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Core depends on Domain for the canonical entity definitions.
      Domain is the innermost layer and carries no external NuGet dependencies.
    -->
    <ProjectReference Include="..\DataViewer.Domain\DataViewer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BCrypt.Net-Next — MIT License — used for password hashing (work factor ≥ 12) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

</Project>
