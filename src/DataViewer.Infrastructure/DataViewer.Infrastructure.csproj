<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>DataViewer.Infrastructure</RootNamespace>
    <AssemblyName>DataViewer.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Clean Architecture dependency graph (inner → outer allowed; outer → inner forbidden):
        Infrastructure → Application (to implement IEncryptionService and other interfaces)
        Infrastructure → Domain     (to throw EncryptionException and reference domain types)
      Application already references Domain, so Domain is transitively available here.
    -->
    <ProjectReference Include="..\DataViewer.Application\DataViewer.Application.csproj" />
    <ProjectReference Include="..\DataViewer.Domain\DataViewer.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.EntityFrameworkCore — MIT license
      Core EF abstractions: DbContext, DbSet<T>, IEntityTypeConfiguration<T>, ModelBuilder.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.7" />

    <!--
      Microsoft.EntityFrameworkCore.Relational — MIT license
      Adds relational-database extensions: ToTable(), HasIndex(), HasFilter(),
      IsDescending(), HasColumnType(), HasData() etc.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.7" />

    <!--
      Npgsql.EntityFrameworkCore.PostgreSQL — PostgreSQL License (permissive, BSD-like)
      PostgreSQL provider for EF Core. Adds UseNpgsql() and maps byte[] → bytea,
      DateTime → timestamptz, and supports jsonb column type annotation.
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />

    <!--
      Pomelo.EntityFrameworkCore.MySql — MIT license
      MySQL / MariaDB provider for EF Core. Adds UseMySql() and maps byte[] → varbinary,
      DateTime → datetime(6), and supports JSON column type annotation.
    -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />

    <!--
      Microsoft.EntityFrameworkCore.Design — MIT license
      Required for EF Core migrations tooling (dotnet-ef add-migration, update-database).
      PrivateAssets="All" so it does not flow to consuming projects at runtime.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!--
      Microsoft.Extensions.DependencyInjection.Abstractions — MIT license (part of .NET 8 SDK)
      Provides IServiceCollection used in InfrastructureServiceExtensions.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />

    <!--
      Serilog — Apache 2.0 license
      Core structured logging library used throughout DataViewer (section 2, ADR-001).
    -->
    <PackageReference Include="Serilog" Version="3.1.1" />

    <!--
      Serilog.AspNetCore — Apache 2.0 license
      Integrates Serilog with the ASP.NET Core request pipeline and ILogger<T> abstraction.
    -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />

    <!--
      Serilog.Sinks.Console — Apache 2.0 license
      Writes log events to stdout; supports JSON and human-readable output themes.
    -->
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!--
      Serilog.Sinks.File — Apache 2.0 license
      Writes log events to rolling files with configurable retention.
    -->
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!--
      Serilog.Formatting.Compact — Apache 2.0 license
      Provides CompactJsonFormatter for machine-readable Production log output (section 7.6).
    -->
    <PackageReference Include="Serilog.Formatting.Compact" Version="2.0.0" />

    <!--
      Serilog.Enrichers.Environment — Apache 2.0 license
      Enriches every log event with MachineName and EnvironmentName properties.
    -->
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.0" />

    <!--
      Serilog.Enrichers.Thread — Apache 2.0 license
      Enriches every log event with ThreadId for correlation in multi-threaded scenarios.
    -->
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />

    <!--
      Serilog.Enrichers.Process — Apache 2.0 license
      Enriches every log event with ProcessId for containerised deployments.
    -->
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />

    <!--
      Microsoft.AspNetCore.Http.Abstractions — MIT license (part of .NET 8 SDK)
      Used to reference IHttpContextAccessor in the logging enricher without a full web dependency.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />

    <!--
      Microsoft.Extensions.Configuration.Abstractions — MIT license (part of .NET 8 SDK)
      Provides IConfiguration for reading Logging:MinimumLevel from appsettings.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />

    <!--
      Microsoft.Extensions.Hosting.Abstractions — MIT license (part of .NET 8 SDK)
      Provides IHostEnvironment to detect Production vs Development at configure time.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>

</Project>
