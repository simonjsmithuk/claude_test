{
  // ──────────────────────────────────────────────────────────────────────────
  // DataViewer — base appsettings (non-secret defaults, section 10.1 of SDD)
  // ──────────────────────────────────────────────────────────────────────────
  // WARNING: This file is committed to source control.
  //          It MUST NOT contain any secrets, credentials, or encryption keys.
  //          All secrets are supplied via environment variables at runtime.
  // ──────────────────────────────────────────────────────────────────────────

  "DatabaseProvider": "postgresql",

  "ConnectionStrings": {
    // Supplied at runtime via DATAVIEWER_DB_CONNECTION environment variable.
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "DataViewer",
    "Audience": "DataViewerClients",
    // JWT__SECRET supplied via environment variable — never stored here.
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeHours": 8
  },

  "S3": {
    "BodySizeCapMb": 5,
    "TransactionFormat": "delimiter",
    "MetadataExtractorStrategy": "path"
  },

  "Auth": {
    "LockoutThreshold": 5,
    "LockoutDurationMinutes": 30
  },

  "Cors": {
    // Populated per-environment in appsettings.Development.json / appsettings.Production.json
    "AllowedOrigins": []
  },

  "Logging": {
    // Controls the Serilog minimum level read by SerilogConfiguration.Configure().
    // Valid values: Verbose, Debug, Information, Warning, Error, Fatal
    "MinimumLevel": "Information"
  },

  "AllowedHosts": "*"
}
