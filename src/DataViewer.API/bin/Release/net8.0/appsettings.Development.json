{
  // ──────────────────────────────────────────────────────────────────────────
  // DataViewer — Development overrides
  // Applied when ASPNETCORE_ENVIRONMENT=Development (local dev, docker-compose)
  // ──────────────────────────────────────────────────────────────────────────

  "ConnectionStrings": {
    // Development database connection
    "DefaultConnection": "Host=winhost;Database=dataviewer;Username=dview;Password=dview01"
  },

  "Cors": {
    // Local Vite dev server (TASK-032: vite.config.ts proxies /api → backend)
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },

  "Logging": {
    // Verbose output in development for rich debugging.
    // Human-readable console format is selected by SerilogConfiguration.Configure()
    // when IHostEnvironment.IsDevelopment() is true.
    // File sink always uses CompactJsonFormatter regardless of environment.
    "MinimumLevel": "Debug"
  }
}
