{
  // ──────────────────────────────────────────────────────────────────────────
  // DataViewer — Production overrides
  // Applied when ASPNETCORE_ENVIRONMENT=Production (Docker, Ubuntu systemd)
  // ──────────────────────────────────────────────────────────────────────────

  "Cors": {
    // Replace with the actual production frontend origin during deployment.
    // This value can also be supplied via the CORS__AllowedOrigins__0 env var.
    "AllowedOrigins": []
  },

  "Logging": {
    // Warning level keeps log volume manageable in production while capturing
    // all actionable events (4xx, 5xx, errors, audit entries).
    // CompactJsonFormatter is selected by SerilogConfiguration.Configure()
    // when IHostEnvironment.IsProduction() is true for the console sink.
    // The file sink always uses CompactJsonFormatter in every environment.
    "MinimumLevel": "Warning"
  }
}
