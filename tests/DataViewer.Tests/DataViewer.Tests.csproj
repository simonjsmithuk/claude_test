<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>DataViewer.Tests</RootNamespace>
    <AssemblyName>DataViewer.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Ensure environment variables set inside tests do not bleed across parallel collections -->
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit runner infrastructure -->
    <PackageReference Include="Microsoft.NET.Test.Sdk"             Version="17.10.0" />
    <PackageReference Include="xunit"                              Version="2.9.0"   />
    <PackageReference Include="xunit.runner.visualstudio"          Version="2.8.2"   >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector"                 Version="6.0.2"   >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Assertion library -->
    <PackageReference Include="FluentAssertions"                   Version="6.12.0"  />

    <!-- Mocking -->
    <PackageReference Include="Moq"                                Version="4.20.70" />

    <!-- Microsoft.Extensions.Logging (for ILogger<T> mocking / NullLogger) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />

    <!-- DI container — used in integration-style DI registration tests -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataViewer.Infrastructure\DataViewer.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\DataViewer.Domain\DataViewer.Domain.csproj"                 />
    <ProjectReference Include="..\..\src\DataViewer.Application\DataViewer.Application.csproj"       />
  </ItemGroup>

</Project>
