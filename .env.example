# DataViewer Environment Variables
# Copy this file to .env and fill in the values

# Encryption key for AWS credentials (32 bytes base64)
# Generate with: openssl rand -base64 32
DATAVIEWER_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# JWT secret for access tokens (32 bytes base64)
# Generate with: openssl rand -base64 32
JWT__SECRET=CHANGE_ME_32_BYTES_BASE64
